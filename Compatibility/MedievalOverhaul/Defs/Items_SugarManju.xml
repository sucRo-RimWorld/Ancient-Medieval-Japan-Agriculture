<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- MO-conditional food. Temporary use of existing AMJ millet-dumpling art
       only; this is NOT approved as a depiction of historical sugar manju. -->
  <ThingDef ParentName="MealFineBase">
    <defName>AMJC_SugarManju</defName>
    <label>sugar manju</label>
    <description>A sweetened steamed wheat bun inspired by sugar manju documented in medieval Japan. Imported sugar makes it an occasional luxury. The exact historical filling and appearance are not reconstructed.</description>
    <graphicData>
      <texPath>Things/Item/Meal/AMJC_MilletDumplings</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases><Nutrition>0.9</Nutrition><MarketValue>24</MarketValue></statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <tasteThought>AMJC_AteSugarManju</tasteThought>
    </ingestible>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Ingredients" />
      <li Class="CompProperties_FoodPoisonable" />
      <li Class="CompProperties_Rottable"><daysToRotStart>2.5</daysToRotStart><rotDestroys>true</rotDestroys></li>
    </comps>
  </ThingDef>
</Defs>
