<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- MO + APS only: original Hay-buildable defs remain unchanged.
       Separate Straw-buildable variants make construction a choice, not a combined bill. -->
  <ThingDef ParentName="AdaptiveStorageBase" MayRequire="Adaptive.PrimitiveStorage">
    <defName>AMJC_APS_Granary_Straw</defName>
    <label>granary (straw)</label>
    <graphicData>
      <texPath>Granary/Granary</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4.5)</drawSize>
      <drawRotated>false</drawRotated>
      <drawOffset>(0,0,0.45)</drawOffset>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <description>A granary for keeping food dry. Items stored inside will never deteriorate and don't affect the beauty of their surroundings.

Total Capacity: 54 Stacks

Built using straw instead of hay.</description>
    <fillPercent>1</fillPercent>
    <researchPrerequisites><li>Stonecutting</li></researchPrerequisites>
    <uiIconPath>Granary/Granary_UI</uiIconPath>
    <uiIconScale>1.5</uiIconScale>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <statBases>
      <Beauty>0</Beauty>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>17500</WorkToBuild>
      <Flammability>0.75</Flammability>
      <Mass>140</Mass>
    </statBases>
    <stuffCategories><li>Stony</li></stuffCategories>
    <costStuffCount>75</costStuffCount>
    <costList>
      <DankPyon_Straw>50</DankPyon_Straw>
      <WoodLog>25</WoodLog>
    </costList>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <defaultStorageSettings><priority>Important</priority><filter><categories><li>PlantFoodRaw</li><li>PlantMatter</li><li>AMJC_Grains</li></categories></filter></defaultStorageSettings>
      <fixedStorageSettings><filter><categories><li>PlantFoodRaw</li><li>PlantMatter</li><li>AMJC_Grains</li></categories></filter></fixedStorageSettings>
      <maxItemsInCell>6</maxItemsInCell>
    </building>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsFurniture</li></thingCategories>
  </ThingDef>

  <ThingDef ParentName="AdaptiveStorageBase" MayRequire="Adaptive.PrimitiveStorage">
    <defName>AMJC_APS_WovenBasket_Straw</defName>
    <label>woven basket (straw)</label>
    <graphicData>
      <texPath>WovenBasket/WovenBasket</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <drawRotated>false</drawRotated>
      <drawOffset>(0,0,0.125)</drawOffset>
    </graphicData>
    <description>A woven basket designed for storing various items. Items stored inside do not affect the beauty of their surroundings.

Total Capacity: 10 Stacks

Rotate to change appearance. Built using straw instead of hay.</description>
    <fillPercent>0.15</fillPercent>
    <uiIconPath>WovenBasket/WovenBasket_UI</uiIconPath>
    <uiIconScale>1.05</uiIconScale>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <statBases>
      <Beauty>1</Beauty>
      <MaxHitPoints>30</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>1</Flammability>
      <Mass>5</Mass>
    </statBases>
    <costList>
      <DankPyon_Straw>75</DankPyon_Straw>
    </costList>
    <resourcesFractionWhenDeconstructed>0.6</resourcesFractionWhenDeconstructed>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>10</maxItemsInCell>
    </building>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsFurniture</li></thingCategories>
  </ThingDef>

