<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Loaded only from Grains' MedievalOverhaul compatibility folder.
       Apply only when Adaptive Primitive Storage is present as well.
       1.6 APS building costs (Hay) are retained 1:1 in MO Straw units.
       No change to other costList entries, Hay production or stored items.
       Conditional paths avoid failed patch operations if APS changes a Def. -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>Adaptive Primitive Storage</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="ASF_Granary"]/costList/Hay</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="ASF_Granary"]/costList/Hay</xpath>
          <value><DankPyon_Straw>50</DankPyon_Straw></value>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="ASF_WovenBasket"]/costList/Hay</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="ASF_WovenBasket"]/costList/Hay</xpath>
          <value><DankPyon_Straw>75</DankPyon_Straw></value>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="ASF_WovenBasketDouble"]/costList/Hay</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="ASF_WovenBasketDouble"]/costList/Hay</xpath>
          <value><DankPyon_Straw>150</DankPyon_Straw></value>
        </match>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="ASF_WovenBasketTriple"]/costList/Hay</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="ASF_WovenBasketTriple"]/costList/Hay</xpath>
          <value><DankPyon_Straw>225</DankPyon_Straw></value>
        </match>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
