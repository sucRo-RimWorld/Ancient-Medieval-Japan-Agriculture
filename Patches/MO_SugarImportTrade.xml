<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Finished sugar is imported to AMJ mainland; local sugarcane cultivation
    and production remain excluded by MO_CropExclusion_Sugarcane.xml.
    Reuse the existing MO noble house art patron's MultiDef stock mechanism,
    already used for Chocolate, without inventing stock quantities or prices.
    Do not edit Chocolate's original generator or any other trader.
    This is an optional-MO trade entry; actual generated trader stock and
    balance still require native acceptance in the final MO/Japanization setup.
  -->
  <Operation Class="PatchOperationAdd" MayRequire="DankPyon.Medieval.Overhaul">
    <xpath>/Defs/TraderKindDef[defName="DankPyon_Caravan_Medieval_ArtPatron"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>DankPyon_Sugar</li>
        </thingDefs>
      </li>
    </value>
  </Operation>
</Patch>
