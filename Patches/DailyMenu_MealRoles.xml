<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="AMJC_MixedGrainMeal" or defName="AMJC_MixedGrainPorridge" or defName="AMJC_MixedFlourFood" or defName="AMJC_WhiteRiceMeal" or defName="AMJC_WhiteRicePorridge" or defName="AMJC_Houtou" or defName="AMJC_Sobagaki" or defName="AMJC_MilletDumplings" or defName="AMJC_BarleyFlourGruel"]</xpath>
    <value><modExtensions><li Class="AMJAgriculture.Dining.MealRoleExtension"><role>Staple</role></li></modExtensions></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DankPyon_MealBoneSoup" or defName="DankPyon_MealMushroomSoup"]</xpath>
    <value><modExtensions><li Class="AMJAgriculture.Dining.MealRoleExtension"><role>Soup</role></li></modExtensions></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="DankPyon_MealGrilledSkewers" or defName="DankPyon_MealFriedEggs" or defName="DankPyon_MealVegetablePot"]</xpath>
    <value><modExtensions><li Class="AMJAgriculture.Dining.MealRoleExtension"><role>Side</role></li></modExtensions></value>
  </Operation>
  <!-- Ordinary wood construction mass: 40/60 units at 0.4 mass per unit. -->
  <Operation Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="DailyMenu_Buffet"]/statBases[not(Mass)]</xpath><value><Mass>16</Mass></value></Operation>
  <Operation Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="DailyMenu_DrinkTable"]/statBases[not(Mass)]</xpath><value><Mass>24</Mass></value></Operation>
</Patch>
