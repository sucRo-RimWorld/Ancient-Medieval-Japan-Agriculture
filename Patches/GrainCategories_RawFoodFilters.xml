<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The storage branch AMJC_Grains includes sheaves and grain in hull.
       Raw-food cooking recipes may use only processed kernels and flour.
       Keep existing raw-food category permissions and add individual items. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/RecipeDef//*[categories/li="PlantFoodRaw" or categories/li="FoodRaw"]/thingDefs</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/RecipeDef//*[categories/li="PlantFoodRaw" or categories/li="FoodRaw"]/thingDefs</xpath>
      <value><li>AMJC_Millet</li><li>AMJC_Buckwheat</li><li>AMJC_Barley</li><li>AMJC_Wheat</li><li>RawRice</li><li>AMJC_WhiteRice</li><li>AMJC_MilletFlour</li><li>AMJC_BuckwheatFlour</li><li>AMJC_BarleyFlour</li><li>AMJC_RiceFlour</li><li>DankPyon_Flour</li></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/RecipeDef//*[categories/li="PlantFoodRaw" or categories/li="FoodRaw"][not(thingDefs)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/RecipeDef//*[categories/li="PlantFoodRaw" or categories/li="FoodRaw"][not(thingDefs)]</xpath>
      <value><thingDefs><li>AMJC_Millet</li><li>AMJC_Buckwheat</li><li>AMJC_Barley</li><li>AMJC_Wheat</li><li>RawRice</li><li>AMJC_WhiteRice</li><li>AMJC_MilletFlour</li><li>AMJC_BuckwheatFlour</li><li>AMJC_BarleyFlour</li><li>AMJC_RiceFlour</li><li>DankPyon_Flour</li></thingDefs></value>
    </match>
  </Operation>
  <!-- Keep existing fixed/default storage filters (including optional storage
       mods) accepting the same grains when their raw-food parent no longer
       contains the AMJC category. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef//filter/categories[(li="PlantFoodRaw" or li="FoodRaw") and not(li="AMJC_Grains")]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef//filter/categories[(li="PlantFoodRaw" or li="FoodRaw") and not(li="AMJC_Grains")]</xpath>
      <value><li>AMJC_Grains</li></value>
    </match>
  </Operation>
</Patch>
