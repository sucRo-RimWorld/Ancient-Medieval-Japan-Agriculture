<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Grains now displays beside MO's cereal branch under Foods. Preserve
       previous inclusion by recipes that filter PlantFoodRaw or FoodRaw. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/RecipeDef//categories[(li="PlantFoodRaw" or li="FoodRaw") and not(li="AMJC_Grains")]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/RecipeDef//categories[(li="PlantFoodRaw" or li="FoodRaw") and not(li="AMJC_Grains")]</xpath>
      <value><li>AMJC_Grains</li></value>
    </match>
  </Operation>
  <!-- Keep existing fixed/default storage filters (including optional storage
       mods) accepting the same grains when their raw-food parent no longer
       contains the AMJC category. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef//filter/categories[(li="PlantFoodRaw" or li="FoodRaw") and not(li="AMJC_Grains")]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef//filter/categories[(li="PlantFoodRaw" or li="FoodRaw") and not(li="AMJC_Grains")]</xpath>
      <value><li>AMJC_Grains</li></value>
    </match>
  </Operation>
</Patch>
