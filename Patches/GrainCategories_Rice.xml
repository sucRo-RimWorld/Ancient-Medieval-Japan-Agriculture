<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Retain RawRice's dedicated storage classification; raw-food recipe filters are bridged separately. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RawRice"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="RawRice"]/thingCategories</xpath>
      <value><li>AMJC_GrainKernels</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="RawRice"]</xpath>
      <value><thingCategories Inherit="False"><li>AMJC_GrainKernels</li></thingCategories></value>
    </nomatch>
  </Operation>
  <!-- RawRice normally inherits PlantFoodRaw; preserve any other explicit categories. -->
  <Operation Class="PatchOperationAttributeSet">
    <xpath>/Defs/ThingDef[defName="RawRice"]/thingCategories</xpath>
    <attribute>Inherit</attribute>
    <value>False</value>
  </Operation>
  <!-- Some providers declare the old category explicitly. Remove only that entry. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RawRice"]/thingCategories/li[text()="PlantFoodRaw"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/ThingDef[defName="RawRice"]/thingCategories/li[text()="PlantFoodRaw"]</xpath>
    </match>
  </Operation>
</Patch>
