<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Author-approved Sugar ThingDef market value: 5.0 (original MO value: 2.2).
    As of 2026-10-26 Agriculture no longer creates custom ArtPatron Sugar stock;
    the Def/value persists for compatibility and possible existing other trade routes.
    Historic 3~6-item custom import offering is suspended by author approval.
    The retained market value 5.0 compares with MO salt=1.0 and spices=2.5;
    it is a gameplay price, not a historical currency conversion.
    Native economy and other-source availability are unverified.
    Agriculture now requires MO and retains the original Sugar Def identity.
  -->
  <Operation Class="PatchOperationReplace" MayRequire="DankPyon.Medieval.Overhaul">
    <xpath>/Defs/ThingDef[defName="DankPyon_Sugar"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>5.0</MarketValue>
    </value>
  </Operation>
</Patch>
