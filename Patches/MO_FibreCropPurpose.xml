<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    AMJ 2026-10-23 fibre-crop ownership: MO Flax is a Japanese textile carrier
    for optional MO + Agriculture, not an edible crop.
    Keep its upstream plant/harvested ThingDefs and numeric balance as-is;
    this root patch repairs classification. Agriculture's MO-conditional
    textile patch owns accepted ramie/cloth labels, research and recipes.
    Do not alter the author's optional MO clothChain setting.
  -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace" MayRequire="DankPyon.Medieval.Overhaul">
        <xpath>/Defs/ThingDef[defName="DankPyon_Plant_Flax"]/plant/purpose</xpath>
        <value>
          <purpose>Misc</purpose>
        </value>
      </li>
      <li Class="PatchOperationReplace" MayRequire="DankPyon.Medieval.Overhaul">
        <xpath>/Defs/ThingDef[defName="DankPyon_RawFlax"]/thingCategories</xpath>
        <value>
          <thingCategories>
            <li>Textiles</li>
          </thingCategories>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
