<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_BuckwheatFlour</defName>
    <label>buckwheat flour</label>
    <description>Buckwheat flour (sobako). Flour made from buckwheat grains after their hulls have been removed. It is used in flour-based foods such as sobagaki, made by mixing the flour with hot water rather than forming noodles.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Buckwheat/BuckwheatFlour</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <Nutrition>0.05</Nutrition>
      <MarketValue>1.5</MarketValue>
    </statBases>
    <stackLimit>75</stackLimit>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>
