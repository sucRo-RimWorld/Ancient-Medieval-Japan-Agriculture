<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Shared millet states for Awa/Hie/Kibi.
    These are deliberately excluded from DankPyon_Cereal so MO's generic
    flour/ale routes cannot bypass AMJ's threshing and hulling steps.
  -->
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RawMillet</defName>
    <label>millet sheaf</label>
    <description>Harvested stalks and seed heads of awa, hie and kibi, tied into sheaves. AMJGrains combines all three harvests into a single millet sheaf item. Threshing and hulling are required to make them edible.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/MilletSheaf</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainSheaves</li></thingCategories>
  </ThingDef>

  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_MilletInHull</defName>
    <label>millet in hull</label>
    <description>Millet kernels separated from the sheaves by threshing, still enclosed in their hulls. The hulls protect them during long storage, but they cannot be eaten until hulled. AMJGrains then treats awa, hie and kibi as a shared edible millet.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/MilletInHull</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainKernels</li></thingCategories>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Millet</defName>
    <label>millet</label>
    <description>Edible grains of awa, hie and kibi with the hulls removed. These millets have long supplemented rice in Japan and have served as everyday staples in some regions. In AMJGrains they can be cooked as grain or milled into millet flour.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Millet/Millet</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainKernels</li></thingCategories>
  </ThingDef>


  <!--
    Buckwheat processing states. They intentionally remain outside
    DankPyon_Cereal so MO generic processing cannot bypass AMJ threshing/hulling.
    Soba-specific production art is wired per state as it is approved. Each
    approved state uses its dedicated AMJ-owned texture path.
  -->
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RawBuckwheat</defName>
    <label>buckwheat sheaf</label>
    <description>Harvested buckwheat stems and seed clusters before threshing. The sheaves are not edible; threshing produces buckwheat still in its hulls. Hulling and milling are later steps.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Buckwheat/BuckwheatSheaf</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.0</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainSheaves</li></thingCategories>
  </ThingDef>

  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_BuckwheatInHull</defName>
    <label>buckwheat in hull</label>
    <description>Buckwheat grains separated from the sheaves by threshing, still covered by their dark hulls. Hulling makes the kernels available for cooking; grinding them further produces buckwheat flour.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Buckwheat/BuckwheatInHull</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.0</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainKernels</li></thingCategories>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Buckwheat</defName>
    <label>buckwheat</label>
    <description>Edible buckwheat kernels with the hulls removed. Before buckwheat noodles became widespread, buckwheat was also cooked as whole grains, including porridge. In AMJGrains it is used in grain meals and porridge, or ground into flour for sobagaki. Its shelf life is shorter than that of millet.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Buckwheat/Buckwheat</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainKernels</li></thingCategories>
  </ThingDef>


  <!--
    Barley processing states. Straw is produced at threshing rather than
    harvest, matching the shared AMJ grain-processing model. Temporary graphics
    use dedicated sheaf art; hulled grain placeholders retain existing AMJ grain assets.
  -->
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RawBarley</defName>
    <label>barley sheaf</label>
    <description>Harvested barley stalks and heads tied into sheaves. The harvest is not edible until it is threshed and hulled, but it can be stored for a long time in this state.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Barley/BarleySheaf</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainSheaves</li></thingCategories>
  </ThingDef>

  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_BarleyInHull</defName>
    <label>barley in hull</label>
    <description>Barley grains separated from stalks and heads by threshing but still covered by their hulls. They store well while hulled, but their hulls must be removed before they can be eaten.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Barley/BarleyInHull</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainKernels</li></thingCategories>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Barley</defName>
    <label>barley</label>
    <description>Edible barley kernels with the hulls removed. Barley has long been cooked with rice or other grains in Japanese meals and porridge. In AMJGrains it can be cooked as grain or milled into barley flour for gruel.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Barley/Barley</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories><li>AMJC_GrainKernels</li></thingCategories>
  </ThingDef>


  <!--
    Processed MO wheat grain. DankPyon_RawWheat remains the harvested sheaf;
    this edible state is the only Stage A wheat item placed in DankPyon_Cereal,
    so MO milling/brewing routes cannot bypass threshing.
    Grain graphic uses the dedicated AMJ wheat icon.
  -->
  <ThingDef ParentName="PlantFoodRawBase">
    <defName>AMJC_Wheat</defName>
    <label>wheat grain</label>
    <description>Edible wheat grain separated from the harvested stalks by threshing. It can be cooked directly or used by Medieval Overhaul cereal-processing recipes such as milling.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AMJC_Wheat/Wheat</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <!-- Grains-owned rice sheaf and husk art; Vanilla RawRice remains the edible output. -->
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RiceSheaf</defName>
    <label>rice sheaf</label>
    <description>Harvested rice stalks and ears tied into sheaves. Threshing and hulling are needed before this rice can be eaten.\n\nIn ancient and medieval Japan, rice was not only food: it was paid as taxes and estate rent. In the late Heian period it also served alongside silk and cloth as a form of commodity money.</description>
    <graphicData><texPath>Things/Item/Resource/AMJC_Rice/RiceSheaf</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <statBases><MarketValue>1.1</MarketValue></statBases>
    <ingestible><foodType>Seed</foodType><preferability>NeverForNutrition</preferability></ingestible>
    <comps><li Class="CompProperties_Rottable"><daysToRotStart>30</daysToRotStart><rotDestroys>true</rotDestroys></li></comps>
    <thingCategories><li>AMJC_GrainSheaves</li></thingCategories>
  </ThingDef>
  <ThingDef ParentName="RoughPlantBase">
    <defName>AMJC_RiceInHull</defName>
    <label>rice in hull</label>
    <description>Rice grains after threshing, still enclosed in their husks. Remove the husks to obtain edible rice.\n\nHulling yields brown rice with its bran and germ intact; further polishing yields white rice. Polishing removes much of the vitamin B1 in the bran and germ.</description>
    <graphicData><texPath>Things/Item/Resource/AMJC_Rice/RiceInHull</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <statBases><MarketValue>1.1</MarketValue></statBases>
    <ingestible><foodType>Seed</foodType><preferability>NeverForNutrition</preferability></ingestible>
    <comps><li Class="CompProperties_Rottable"><daysToRotStart>120</daysToRotStart><rotDestroys>true</rotDestroys></li></comps>
    <thingCategories><li>AMJC_GrainKernels</li></thingCategories>
  </ThingDef>

</Defs>
