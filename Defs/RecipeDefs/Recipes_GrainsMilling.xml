<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>AMJC_MillBuckwheat</defName>
    <label>mill buckwheat</label>
    <description>Grind 10 dehulled buckwheat grains into 10 units of buckwheat flour.</description>
    <jobString>Milling buckwheat.</jobString>
    <workAmount>300</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <allowMixingIngredients>false</allowMixingIngredients>
    <targetCountAdjustment>10</targetCountAdjustment>
    <recipeUsers>
      <li>AMJC_ManualMillstone</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>AMJC_Buckwheat</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>AMJC_Buckwheat</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <products>
      <AMJC_BuckwheatFlour>10</AMJC_BuckwheatFlour>
    </products>
  </RecipeDef>
