  <RecipeDef>
    <defName>AMJC_CookRiceMeal</defName>
    <label>cook 1 rice meal</label>
    <description>Cook 1 servings of rice meal using only dehulled rice.</description>
    <jobString>Cooking rice meal.</jobString>
    <workAmount>220</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat><workSkill>Cooking</workSkill>
    <allowMixingIngredients>false</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients><li><filter><thingDefs><li>RawRice</li></thingDefs></filter><count>0.5</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>RawRice</li></thingDefs><specialFiltersToDisallow><li>AllowRotten</li></specialFiltersToDisallow></fixedIngredientFilter>
    <products><AMJC_RiceMeal>1</AMJC_RiceMeal></products>
  </RecipeDef>

