<Defs>
  <RecipeDef>
    <defName>AMJC_CookHoutou</defName>
    <label>cook houtou</label>
    <description>Prepare one serving of hakutaku using wheat flour.</description>
    <jobString>Cooking hakutaku.</jobString>
    <workAmount>300</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <recipeUsers>
      <li>Campfire</li>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>AMJC_WheatFlour</li>
          </thingDefs>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>AMJC_WheatFlour</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <products>
      <AMJC_Houtou>1</AMJC_Houtou>
    </products>
  </RecipeDef>
